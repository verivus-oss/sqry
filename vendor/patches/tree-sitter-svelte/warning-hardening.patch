@@ -118,6 +118,7 @@ bool scan_comment(TSLexer *lexer) {
         lexer->mark_end(lexer);
         return true;
       }
+      break;
     default:
       dashes = 0;
     }
@@ -445,14 +446,18 @@ bool scan(Scanner *scanner, TSLexer *lexer, const bool *valid_symbols) {
 
 #ifndef _MSC_VER
 #pragma GCC diagnostic push
