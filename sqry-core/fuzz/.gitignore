target
artifacts
coverage

# Ignore fuzzer-generated corpus files (keep only seeds/)
corpus/*
!corpus/query_parser/
!corpus/query_parser/seeds/
corpus/query_parser/generated/
# Ignore hash-named files in corpus root (fuzzer's active working set)
corpus/query_parser/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

